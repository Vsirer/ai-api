# Compose 项目名；同一台机器上的 data/node/gateway 必须保持一致，便于共享网络和卷。
COMPOSE_PROJECT_NAME=new-api

# 生产访问域名，必须提前把 A 记录解析到入口服务器公网 IP。
DOMAIN=example.com

# Caddy 接收并自动签发 HTTPS 的域名，多个域名用英文逗号加空格分隔。
# DOMAIN 仍只表示主站域名，避免影响 FRONTEND_BASE_URL。
CADDY_DOMAINS=example.com, cname.example.com

# Caddy 申请 HTTPS 证书时使用的邮箱，建议填写可接收告警的运维邮箱。
ACME_EMAIL=admin@example.com

# 容器时区。
TZ=Asia/Shanghai

# 自定义业务镜像名称和固定版本号；生产环境禁止使用 latest，方便回滚。
NEW_API_IMAGE=ghcr.io/vsirer/new-api
NEW_API_VERSION=v2026.05.11

# 当前节点类型；主节点使用 master，从节点使用 slave。集群里通常只保留一个 master。
NODE_TYPE=master

# 节点名称，用于日志审计和后续多节点部署识别。
NODE_NAME=new-api-master-1

# 可选：固定 new-api 容器名。多套部署在同一台机器时必须改成不同名称。
APP_CONTAINER_NAME=new-api

# 应用容器端口绑定。主节点需要被 Caddy 容器访问时建议绑定本机；需要给内网 LB 访问时改成内网 IP。
APP_BIND_IP=127.0.0.1
APP_PORT=3000

# 可选：固定 PostgreSQL 容器名。多套部署在同一台机器时必须改成不同名称。
POSTGRES_CONTAINER_NAME=new-api-postgres

# 首次部署可先在 master/数据层服务器执行以下命令生成强随机密钥，然后填入下面对应变量：
# PG_PASS=$(openssl rand -hex 32)
# REDIS_PASS=$(openssl rand -hex 32)
# SESSION_SECRET=$(openssl rand -hex 32)
# CRYPTO_SECRET=$(openssl rand -hex 32)
#
# 对应关系：
# POSTGRES_PASSWORD=${PG_PASS}
# REDIS_PASSWORD=${REDIS_PASS}
# SESSION_SECRET=${SESSION_SECRET}
# CRYPTO_SECRET=${CRYPTO_SECRET}

# PostgreSQL 数据库账号、密码、库名；生产密码必须改成强随机值。
POSTGRES_USER=newapi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=newapi

# PostgreSQL 连接地址。主节点和 infra 在同一 Compose 网络时使用 postgres；子节点使用主库内网 IP。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# PostgreSQL 对宿主机的绑定地址。单机默认仅本机访问；给子节点访问时改成 A 服务器内网 IP。
POSTGRES_BIND_IP=127.0.0.1

# 可选：固定 Redis 容器名。多套部署在同一台机器时必须改成不同名称。
REDIS_CONTAINER_NAME=new-api-redis

# Redis 密码；生产必须启用强密码，且不要暴露 Redis 端口到公网。
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Redis 连接地址。主节点和 infra 在同一 Compose 网络时使用 redis；子节点使用 Redis 内网 IP。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Redis 对宿主机的绑定地址。单机默认仅本机访问；给子节点访问时改成 A 服务器内网 IP。
REDIS_BIND_IP=127.0.0.1

# Web 会话密钥；所有 new-api 节点必须一致，生产必须改成强随机值。
SESSION_SECRET=CHANGE_ME_STRONG_SESSION_SECRET

# 加密密钥；所有 new-api 节点必须一致，生产必须改成强随机值且上线后不要随意更换。
CRYPTO_SECRET=CHANGE_ME_STRONG_CRYPTO_SECRET

# 可选：固定 Caddy 容器名。多套部署在同一台机器时必须改成不同名称。
CADDY_CONTAINER_NAME=new-api-caddy

# Caddy 对外监听地址。通常入口服务器使用 0.0.0.0。
HTTP_BIND_IP=0.0.0.0
HTTPS_BIND_IP=0.0.0.0

# Caddy 反代上游。单机默认反代 Compose 网络内的 new-api；多节点可写成 new-api:3000 10.0.0.2:3000。
APP_UPSTREAMS=new-api:3000

# Caddy 按需签发分站 SSL 前调用的准入接口上游，只能填写一个主节点地址。
SUB_SITE_TLS_ASK_UPSTREAM=new-api:3000

# 分站自定义域名同样由 Caddy 接入。上线分站前需确认：
# 1. 分站域名 A/CNAME 已解析到入口服务器；
# 2. 后台“分销中心 / 全局设置”已填写对应 CNAME 目标；
# 3. SUB_SITE_TLS_ASK_UPSTREAM 能访问主节点 /api/sub-site/tls/allow。

# 启用错误日志，便于生产问题排查。
ERROR_LOG_ENABLED=true

# 启用批量更新，降低高频写入带来的数据库压力。
BATCH_UPDATE_ENABLED=true

# 启用内存缓存；Redis 仍作为共享缓存和持久化辅助。
MEMORY_CACHE_ENABLED=true

# 渠道缓存刷新频率，单位秒。
CHANNEL_UPDATE_FREQUENCY=30

# 批量更新间隔，单位秒。
BATCH_UPDATE_INTERVAL=5

# 流式响应无数据超时时间，单位秒；上游模型响应慢时可适当调大。
STREAMING_TIMEOUT=300

# 是否自动生成默认 Token；生产建议关闭，避免默认凭据风险。
GENERATE_DEFAULT_TOKEN=false
