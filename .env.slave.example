# Compose 项目名。子节点可以和主节点不同，但同一台机器上的 app/edge 必须一致。
COMPOSE_PROJECT_NAME=new-api

# 对外展示域名。纯 slave 节点通常不直接对外，但仍建议保持和主入口一致。
DOMAIN=example.com

# Caddy 接收并自动签发 HTTPS 的域名，多个域名用英文逗号加空格分隔。
# DOMAIN 仍只表示主站域名，避免影响 FRONTEND_BASE_URL。
CADDY_DOMAINS=example.com, cname.example.com

# 容器时区。
TZ=Asia/Shanghai

# 业务镜像名称和固定版本号；必须和 master 节点保持一致。
NEW_API_IMAGE=ghcr.io/vsirer/new-api
NEW_API_VERSION=v2026.05.11

# 子节点必须设置为 slave，避免多 master 后台任务重复执行。
NODE_TYPE=slave

# 节点名称，用于日志审计和多节点识别。
NODE_NAME=new-api-slave-1

# 可选：固定 new-api 容器名。多套部署在同一台机器时必须改成不同名称。
APP_CONTAINER_NAME=new-api

# 子节点应用端口绑定。建议绑定服务器内网 IP，并通过安全组只允许入口服务器访问。
APP_BIND_IP=0.0.0.0
APP_PORT=3000

# 注意：slave 节点不要重新生成这些密钥，必须从 master/数据层 .env 复制相同值：
# POSTGRES_PASSWORD=${PG_PASS}
# REDIS_PASSWORD=${REDIS_PASS}
# SESSION_SECRET=${SESSION_SECRET}
# CRYPTO_SECRET=${CRYPTO_SECRET}

# 共享 PostgreSQL 账号、密码、库名；必须和 master/infra 节点一致。
POSTGRES_USER=newapi
POSTGRES_PASSWORD=CHANGE_ME_SAME_AS_MASTER_POSTGRES_PASSWORD
POSTGRES_DB=newapi

# 共享 PostgreSQL 地址；填写主库内网 IP 或云数据库内网地址。
POSTGRES_HOST=10.0.0.10
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# 共享 Redis 密码；必须和 master/infra 节点一致。
REDIS_PASSWORD=CHANGE_ME_SAME_AS_MASTER_REDIS_PASSWORD

# 共享 Redis 地址；填写 Redis 内网 IP 或云 Redis 内网地址。
REDIS_HOST=10.0.0.10
REDIS_PORT=6379
REDIS_DB=0

# Web 会话密钥；必须和 master 节点完全一致。
SESSION_SECRET=CHANGE_ME_SAME_AS_MASTER_SESSION_SECRET

# 加密密钥；必须和 master 节点完全一致。
CRYPTO_SECRET=CHANGE_ME_SAME_AS_MASTER_CRYPTO_SECRET

# slave 节点也保留同样的运行参数，避免行为和 master 不一致。
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
MEMORY_CACHE_ENABLED=true
CHANNEL_UPDATE_FREQUENCY=30
BATCH_UPDATE_INTERVAL=5
STREAMING_TIMEOUT=300
GENERATE_DEFAULT_TOKEN=false
